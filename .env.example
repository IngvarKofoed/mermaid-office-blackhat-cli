# Copy to `.env` in this folder and fill in.
#   cp .env.example .env && chmod 600 .env
#
# Every value can also be supplied as a real environment variable, which wins
# over this file. If you'd rather keep it outside the folder, put the same
# lines in ~/.blackhat.env instead.

# Base URL of the Mermaid Office server (no trailing slash).
MERMAID_URL=http://localhost:8601

# Your login — the same email + password you use on the site.
MERMAID_EMAIL=you@example.com
MERMAID_PASSWORD=your-password
